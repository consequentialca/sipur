# Sipur — Environment Variables
# Copy to .env.local and fill in your keys

# Required — Anthropic API (story generation + pre-live Daas classification)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required — Supabase (auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Future — ElevenLabs TTS
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=your_chosen_voice_id

# Future — Daas API (when live, swap getDaasClassification() to use this)
# DAAS_API_KEY=your_daas_api_key_here
# DAAS_API_URL=https://api.daas.ai/v1/classify

# Future — Image generation (story cover)
# REPLICATE_API_KEY=your_replicate_api_key_here
